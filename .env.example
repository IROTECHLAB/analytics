# ─── App ──────────────────────────────────────────────
# Public base URL (no trailing slash)
APP_URL=https://analytics.irotechlab.xi.to
# Cookie domain — leave blank for host-only cookie
COOKIE_DOMAIN=
NODE_ENV=production

# ─── IrotechLab Auth ─────────────────────────────────
# Register your own app at:
# https://auth.irotechlab.xi.to/developer/new
IRO_ISSUER=https://auth.irotechlab.xi.to
IRO_CLIENT_ID=
IRO_CLIENT_SECRET=
IRO_WEBHOOK_SECRET=

# ─── Database (Neon Postgres) ────────────────────────
DATABASE_URL=

# ─── Session ─────────────────────────────────────────
# 32+ bytes, base64. Generate: openssl rand -base64 32
SESSION_SECRET=
